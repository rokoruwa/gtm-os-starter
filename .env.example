# Names only. Put values in .env, which git ignores.
# Nothing in this repo needs these to run the examples or the tests.
# They're here for connectors you add later.

# LinkedIn analytics export access, used by post-performance if you automate exports
LINKEDIN_ACCESS_TOKEN=

# CRM read access, used by scorecard if you automate CRM reports
CRM_API_KEY=

# Email tool read access, used by scorecard for founder email reply rate
EMAIL_TOOL_API_KEY=
